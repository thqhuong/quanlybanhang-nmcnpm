<UserControl x:Class="quanlybanhang_nmcnpm.Views.ProductsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="DANH MỤC HÀNG HÓA" FontSize="18" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE710; Thêm Mới (F2)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#2E7D32"/>
                <Button Content="&#xE70F; Sửa (F3)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#004C99"/>
                <Button Content="&#xE74D; Xóa (F4)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#C62828"/>
                <Button Content="&#xE72C; Nạp Lại (F5)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,35,0,0"/>

        <!-- Search & Filter -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333333"/>
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Width="250" Height="30" Margin="0,0,20,0">
                    <Grid>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#999999" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="30,0,5,0" Text="Nhập mã hoặc tên sản phẩm..." Foreground="#999999"/>
                    </Grid>
                </Border>

                <TextBlock Text="Nhóm:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#333333"/>
                <ComboBox Width="150" Height="30" VerticalContentAlignment="Center" Margin="0,0,15,0">
                    <ComboBoxItem IsSelected="True">-- Tất cả nhóm --</ComboBoxItem>
                    <ComboBoxItem>Bánh kẹo</ComboBoxItem>
                    <ComboBoxItem>Sữa</ComboBoxItem>
                </ComboBox>

                <Button Content="&#xE71C; Lọc" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="15,0"/>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <ListView Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" Foreground="#999999" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Mã Hàng" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Code}" Foreground="#004C99" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tên Hàng Hóa" Width="250" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Nhóm Hàng" Width="150" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="ĐVT" Width="80" DisplayMemberBinding="{Binding Unit}"/>
                    <GridViewColumn Header="Đơn Giá Bán" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tồn Kho" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Stock}" FontWeight="Bold" Foreground="{Binding StockColor}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <Grid>
                <TextBlock Text="Tổng số bản ghi: 5" Foreground="#333333" FontStyle="Italic" HorizontalAlignment="Left"/>
                <TextBlock Text="Dữ liệu được cập nhật mới nhất lúc 16:04:01" Foreground="#666666" FontStyle="Italic" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
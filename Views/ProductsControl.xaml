<UserControl x:Class="quanlybanhang_nmcnpm.Views.ProductsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="DANH MỤC HÀNG HÓA" FontSize="18" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE8A5; Tạo mới" Command="{Binding NewCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                <Button Content="&#xE710; Thêm" Command="{Binding AddCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#2E7D32"/>
                <Button Content="&#xE70F; Cập nhật" Command="{Binding UpdateCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#004C99"/>
                <Button Content="&#xE74D; Xóa" Command="{Binding DeleteCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Foreground="#C62828"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Mã sản phẩm"/>
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Tên hàng hóa"/>
                <TextBox Grid.Column="2" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Đơn vị tính"/>
                <TextBox Grid.Column="3" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Height="30" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Đơn giá bán"/>
                <TextBox Grid.Column="4" Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}" Height="30" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Tồn kho"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Height="30" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="&#xE721; Lọc" Command="{Binding SearchCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="15,0"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#666666"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="3" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" BorderBrush="#E0E0E0" BorderThickness="1" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="45" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Mã hàng" Width="100" DisplayMemberBinding="{Binding Code}"/>
                    <GridViewColumn Header="Tên hàng hóa" Width="260" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Nhóm hàng" Width="150" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="ĐVT" Width="70" DisplayMemberBinding="{Binding Unit}"/>
                    <GridViewColumn Header="Đơn giá bán" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tồn kho" Width="90" DisplayMemberBinding="{Binding Stock}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#333333" FontStyle="Italic"/>
        </Border>
    </Grid>
</UserControl>

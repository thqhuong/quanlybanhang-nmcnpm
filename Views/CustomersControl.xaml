<UserControl x:Class="quanlybanhang_nmcnpm.Views.CustomersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="QUẢN LÝ KHÁCH HÀNG &amp; TÍCH ĐIỂM" FontSize="18" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE8A5; Tạo mới" Command="{Binding NewCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                <Button Content="&#xE710; Thêm" Command="{Binding AddCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#2E7D32"/>
                <Button Content="&#xE70F; Cập nhật" Command="{Binding UpdateCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#004C99"/>
                <Button Content="&#xE74D; Xóa" Command="{Binding DeleteCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Foreground="#C62828"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Tên khách hàng" Tag="Tên khách hàng" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Số điện thoại" Tag="Số điện thoại" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Email" Tag="Email" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="3" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Địa chỉ" Tag="Địa chỉ" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="4" Text="{Binding PointsText, UpdateSourceTrigger=PropertyChanged}" Height="32" TextAlignment="Right" VerticalContentAlignment="Center" ToolTip="Điểm tích lũy" Tag="Điểm tích lũy" Style="{StaticResource WatermarkTextBoxStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" Tag="Tìm kiếm khách hàng" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <Button Content="&#xE721; Lọc" Command="{Binding SearchCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="15,0"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#666666"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="3" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" BorderBrush="#E0E0E0" BorderThickness="1" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="45" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Số điện thoại" Width="150" DisplayMemberBinding="{Binding Phone}"/>
                    <GridViewColumn Header="Tên khách hàng" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Email" Width="200" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Điểm" Width="80" DisplayMemberBinding="{Binding Points}"/>
                    <GridViewColumn Header="Lần mua cuối" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastPurchase, StringFormat={}{0:dd/MM/yyyy}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#333333"/>
        </Border>
    </Grid>
</UserControl>

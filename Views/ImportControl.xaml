<UserControl x:Class="quanlybanhang_nmcnpm.Views.ImportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="LẬP PHIẾU NHẬP KHO" FontSize="18" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE8A5; Tạo mới" Command="{Binding NewCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                <Button Content="&#xE74E; Lưu phiếu" Command="{Binding SaveCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="#E8F5E9" BorderBrush="#81C784" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#2E7D32" FontWeight="Bold"/>
                <Button Content="&#xE749; In" Command="{Binding PrintCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="THÔNG TIN CHUNG" FontWeight="Bold" Foreground="#004C99" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,-71">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17*"/>
                            <ColumnDefinition Width="140*"/>
                            <ColumnDefinition Width="157*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nhà cung cấp:" VerticalAlignment="Center" FontWeight="SemiBold" Grid.ColumnSpan="2" Height="16"/>
                        <Grid Grid.Column="1" Margin="61,4,10,4">
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="32" VerticalContentAlignment="Center" Style="{StaticResource FieldComboBoxStyle}"/>
                            <TextBlock Text="Chọn nhà cung cấp" Foreground="#999999" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSupplier}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Bên giao:" VerticalAlignment="Top" FontWeight="SemiBold" Grid.ColumnSpan="2" Height="24" Margin="0,7,0,0"/>
                        <TextBox Grid.Row="1" Text="{Binding DeliveredBy, UpdateSourceTrigger=PropertyChanged}" Margin="61,4,10,-5" VerticalContentAlignment="Center" Tag="Bên giao" Style="{StaticResource WatermarkTextBoxStyle}" Grid.Column="1"/>

                        <TextBlock Grid.Column="2" Text="Ngày nhập:" VerticalAlignment="Center" FontWeight="SemiBold" Height="16"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding ReceiptDate}" Margin="95,4,0,3" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" Grid.Row="1" Text="Ghi chú:" VerticalAlignment="Top" FontWeight="SemiBold" Height="14" Margin="0,10,0,0"/>
                        <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="95,4,0,-5" VerticalContentAlignment="Center" Tag="Ghi chú" Style="{StaticResource WatermarkTextBoxStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE783;" FontSize="40" Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="TỔNG TIỀN THANH TOÁN" FontWeight="Bold" Foreground="#546E7A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8F9FA" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" x:Name="InputArea">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,4,0" Padding="5,0" Tag="Mã SP" Style="{StaticResource WatermarkTextBoxStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="4,0,4,0" Tag="Tên sản phẩm" Style="{StaticResource WatermarkTextBoxStyle}"/>
                        <TextBox Grid.Column="2" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Height="32" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,4,0" Tag="Số lượng" Style="{StaticResource WatermarkTextBoxStyle}"/>
                        <Button Grid.Column="3" Command="{Binding AddLineCommand}" Background="#0078D7" Foreground="White" BorderThickness="0" Height="30" Content="Thêm" Margin="4,0,0,0"/>
                        <Button Grid.Column="4" Command="{Binding RemoveLineCommand}" Background="#C62828" Foreground="White" BorderThickness="0" Height="30" Margin="4,0,0,0" Content="Xóa dòng"/>
                    </Grid>
                </Border>

                <Popup Grid.Row="1" IsOpen="{Binding IsSuggestionPopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=InputArea}" StaysOpen="False" MaxHeight="200" Width="500">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White" CornerRadius="2">
                        <ListView ItemsSource="{Binding SearchSuggestions}" SelectedItem="{Binding SelectedSuggestion}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mã SP" Width="80" DisplayMemberBinding="{Binding Code}"/>
                                    <GridViewColumn Header="Tên hàng hóa" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="ĐVT" Width="60" DisplayMemberBinding="{Binding Unit}"/>
                                    <GridViewColumn Header="Đơn giá" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Popup>

                <ListView Grid.Row="1" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Mã SP" Width="100" DisplayMemberBinding="{Binding Code}"/>
                            <GridViewColumn Header="Tên hàng hóa" Width="260" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="ĐVT" Width="70" DisplayMemberBinding="{Binding Unit}"/>
                            <GridViewColumn Header="Số lượng" Width="90" DisplayMemberBinding="{Binding Quantity}"/>
                            <GridViewColumn Header="Đơn giá nhập" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitCost, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Thành tiền" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#333333"/>
                <TextBlock Text="{Binding LineCount, StringFormat= Tổng số mặt hàng: {0}}" Foreground="#333333" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

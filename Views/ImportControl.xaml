<UserControl x:Class="quanlybanhang_nmcnpm.Views.ImportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="LẬP PHIẾU NHẬP KHO" FontSize="18" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE8A5; Tạo Mới (F2)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#004C99"/>
                <Button Content="&#xE74E; Lưu Phiếu (F9)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="#E8F5E9" BorderBrush="#81C784" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#2E7D32" FontWeight="Bold"/>
                <Button Content="&#xE749; In (F11)" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,35,0,0"/>

        <!-- Info & Summary -->
        <Grid Grid.Row="1" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- General Info -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="THÔNG TIN CHUNG" FontWeight="Bold" Foreground="#004C99" Margin="0,0,0,15"/>
                    <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,20,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Col -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="Nhà cung cấp:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Margin="90,4,0,4" VerticalContentAlignment="Center">
                                    <ComboBoxItem IsSelected="True">Công ty TNHH ABC</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="Người giao:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Margin="90,4,0,4" VerticalContentAlignment="Center" Text="Nguyễn Văn A" Foreground="#666666"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBlock Text="Ghi chú:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Margin="90,4,0,4" VerticalContentAlignment="Center" Text="Nhập kho đợt 1 tháng" Foreground="#666666"/>
                            </Grid>
                        </Grid>

                        <!-- Right Col -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="Số phiếu:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Margin="90,4,0,4" VerticalContentAlignment="Center" Text="PN00124" Foreground="#D32F2F" FontWeight="Bold" Background="#F5F5F5" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="Ngày nhập:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Margin="90,4,0,4" VerticalContentAlignment="Center" Text="08/05/2026" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBlock Text="Kho nhập:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Margin="90,4,0,4" VerticalContentAlignment="Center">
                                    <ComboBoxItem IsSelected="True">Kho Chính (K01)</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Total Payment -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE783;" FontSize="40" Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="TỔNG TIỀN THANH TOÁN" FontWeight="Bold" Foreground="#546E7A" HorizontalAlignment="Center"/>
                    <TextBlock Text="6.000.000 đ" FontSize="28" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Data Grid Section -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Entry Row -->
                <Border Grid.Row="0" Background="#F8F9FA" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="MÃ SP (F3)" Foreground="#999999" Height="30" VerticalContentAlignment="Center" Margin="0,0,5,0" Padding="5,0"/>
                        <TextBox Grid.Column="1" Text="Tên hàng hóa" Foreground="#999999" Height="30" VerticalContentAlignment="Center" Margin="0,0,5,0" Padding="5,0"/>
                        <TextBox Grid.Column="2" Text="1" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="3" Text="Đơn giá nhập" Foreground="#999999" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                        <Button Grid.Column="4" Background="#0078D7" Foreground="White" BorderThickness="0" Height="30">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe UI" Text="+" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="Thêm"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- List -->
                <ListView Grid.Row="1" BorderThickness="0" x:Name="ImportListView">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Mã SP" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Code}" Foreground="#004C99"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Tên Hàng Hóa" Width="250" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="ĐVT" Width="60" DisplayMemberBinding="{Binding Unit}"/>
                            <GridViewColumn Header="Số Lượng" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Đơn Giá Nhập" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Price}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Thành Tiền" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Total}" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Foreground="#C62828" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <TextBlock Text="Tổng số mặt hàng: 1" Foreground="#333333"/>
        </Border>
    </Grid>
</UserControl>
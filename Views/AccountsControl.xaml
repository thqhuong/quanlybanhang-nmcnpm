<UserControl x:Class="quanlybanhang_nmcnpm.Views.AccountsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" Background="White" Width="983">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="QUẢN LÝ TÀI KHOẢN" FontSize="20" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE8A5; Tạo mới" Command="{Binding NewCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0"/>
                <Button Content="&#xE710; Thêm" Command="{Binding AddCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#2E7D32"/>
                <Button Content="&#xE70F; Cập nhật" Command="{Binding UpdateCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,8,0" Foreground="#004C99"/>
                <Button Content="&#xE72E; Khóa/Mở" Command="{Binding ToggleActiveCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Foreground="#C62828"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="113"/>
                    <ColumnDefinition Width="113"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="114"/>
                    <ColumnDefinition Width="302"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Tên đăng nhập" Tag="Tên đăng nhập" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Họ tên" Tag="Họ tên" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="2" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Số điện thoại" Tag="Số điện thoại" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <TextBox Grid.Column="3" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Email" Tag="Email" Style="{StaticResource WatermarkTextBoxStyle}"/>
                <Grid Grid.Column="4" Margin="0,0,8,0">
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" Height="32" VerticalContentAlignment="Center" Style="{StaticResource FieldComboBoxStyle}"/>
                    <TextBlock Text="Vai trò" Foreground="#999999" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRole}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <PasswordBox Grid.Column="5" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Mật khẩu" Tag="Mật khẩu" Style="{StaticResource WatermarkPasswordBoxStyle}" PasswordChanged="PasswordBox_PasswordChanged"/>
                <CheckBox Grid.Column="6" Content="Hoạt động" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Height="16"/>
            </Grid>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" BorderBrush="#E0E0E0" BorderThickness="1" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="45" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Tên đăng nhập" Width="150" DisplayMemberBinding="{Binding Username}"/>
                    <GridViewColumn Header="Họ và tên" Width="220" DisplayMemberBinding="{Binding FullName}"/>
                    <GridViewColumn Header="Email" Width="190" DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Vai trò" Width="150" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="Hoạt động" Width="90" DisplayMemberBinding="{Binding IsActive}"/>
                    <GridViewColumn Header="Đăng nhập cuối" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastLoginAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#333333"/>
        </Border>
    </Grid>
</UserControl>

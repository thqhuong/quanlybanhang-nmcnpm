<UserControl x:Class="quanlybanhang_nmcnpm.Views.AccountsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="QUẢN LÍ TÀI KHOẢN" FontSize="20" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE710; Thêm Mới" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#2E7D32"/>
                <Button Content="&#xE70F; Chỉnh Sửa" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#004C99"/>
                <Button Content="&#xE934; Đổi Mật Khẩu" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Margin="0,0,10,0" Foreground="#F57F17"/>
                <Button Content="&#xE74D; Xóa" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="White" BorderBrush="#CCCCCC" Height="30" Padding="10,0" Foreground="#C62828"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,40,0,0"/>

        <!-- Search -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,15,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="2" Width="300" Height="30">
                    <Grid>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#999999" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="30,0,5,0" Tag="Tên đăng nhập, họ tên..."/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <ListView Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" AlternationCount="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" Foreground="#999999" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Tên Đăng Nhập" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Foreground="#004C99"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Họ và Tên" Width="200" DisplayMemberBinding="{Binding FullName}"/>
                    <GridViewColumn Header="Vai Trò" Width="180" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="Trạng Thái" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,4">
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Đăng Nhập Lần Cuối" Width="160" DisplayMemberBinding="{Binding LastLogin}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
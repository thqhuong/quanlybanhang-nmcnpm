<UserControl x:Class="quanlybanhang_nmcnpm.Views.SalesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000" Background="#F1F3F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="BÁN HÀNG TẠI QUẦY" FontSize="16" FontWeight="Bold" Foreground="#004C99" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE8A5; Đơn mới" Command="{Binding NewOrderCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="#E0E0E0" BorderThickness="0" Padding="10,5" Height="30" Margin="0,0,8,0"/>
                    <Button Content="&#xE8A5; Xuất hóa đơn" Command="{Binding ExportReceiptCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="#E0E0E0" BorderThickness="0" Padding="10,5" Height="30" Margin="0,0,8,0"/>
                    <Button Content="&#xE749; In hóa đơn" Command="{Binding PrintReceiptCommand}" FontFamily="Segoe UI, Segoe MDL2 Assets" Background="#E0E0E0" BorderThickness="0" Padding="10,5" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Mã hoặc tên sản phẩm" FontSize="12" Foreground="#666666" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" BorderBrush="#0078D7" BorderThickness="2" Padding="10,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Số lượng" FontSize="12" Foreground="#666666" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Height="35" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding AddProductCommand}" Background="#0078D7" Foreground="White" BorderThickness="0" Height="35" VerticalAlignment="Bottom" Content="Thêm"/>
                            <Button Grid.Column="3" Command="{Binding RemoveLineCommand}" Background="#C62828" Foreground="White" BorderThickness="0" Height="35" VerticalAlignment="Bottom" Margin="8,0,0,0" Content="Xóa dòng"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Mã SP" Width="90" DisplayMemberBinding="{Binding Code}"/>
                                <GridViewColumn Header="Tên hàng hóa" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="SL" Width="60" DisplayMemberBinding="{Binding Quantity}"/>
                                <GridViewColumn Header="Đơn giá" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Thành tiền" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15">
                        <TextBlock Text="THÔNG TIN THANH TOÁN" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Khách hàng" FontSize="12" Foreground="#666666" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tổng tiền hàng:" Foreground="#666666"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N0} đ}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giảm giá:" Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Height="30" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                            </Grid>

                            <Grid>
                                <TextBlock Text="VAT (8%):" Foreground="#666666"/>
                                <TextBlock Text="{Binding Vat, StringFormat={}{0:N0} đ}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="KHÁCH CẦN TRẢ:" FontWeight="Bold" Foreground="#004C99"/>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0} đ}" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Khách thanh toán" FontSize="12" Foreground="#666666" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PaymentText, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" Foreground="#2E7D32" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#CCCCCC" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Tiền thối:" Foreground="#666666"/>
                                <TextBlock Text="{Binding Change, StringFormat={}{0:N0} đ}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="#666666" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <Button Command="{Binding CheckoutCommand}" Background="#2E7D32" Foreground="White" Height="45" BorderThickness="0" Content="THANH TOÁN (F9)" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

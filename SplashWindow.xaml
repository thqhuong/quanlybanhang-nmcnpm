<Window x:Class="quanlybanhang_nmcnpm.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="#0C78E4"
        WindowStartupLocation="CenterScreen"
        Width="480" Height="320"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74C;" FontSize="56" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Hệ thống Quản lý Bán hàng" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="NMCNPM" FontSize="14" Foreground="#B0D4F1" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,30,0,0">
            <TextBlock x:Name="StatusText" Text="Đang khởi tạo..." FontSize="13" Foreground="#D0E8F7" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="quanlybanhang_nmcnpm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:quanlybanhang_nmcnpm"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Bán hàng" Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <Style TargetType="Button" x:Key="RoleButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="40,5,40,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FAFAFA"/>
                                <Setter Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="-8" Duration="0:0:0.05" AutoReverse="True"
                             RepeatBehavior="3x"/>
        </Storyboard>
    </Window.Resources>

    <StackPanel x:Name="LoginPanel" Margin="0,30,0,0" HorizontalAlignment="Center" Width="340"
                RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
            <TranslateTransform/>
        </StackPanel.RenderTransform>

        <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="Bold" Foreground="#123E82" HorizontalAlignment="Center" Margin="0,10,0,15"/>
        <TextBlock Text="Vui lòng đăng nhập để tiếp tục" FontSize="16" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <TextBox x:Name="UsernameBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12" Tag="Tên đăng nhập" Style="{StaticResource WatermarkTextBoxStyle}" KeyDown="Input_KeyDown"/>
        <PasswordBox x:Name="PasswordBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12" Tag="Mật khẩu" Style="{StaticResource WatermarkPasswordBoxStyle}" KeyDown="PasswordBox_KeyDown"/>

        <TextBlock x:Name="CapsLockWarning" Text="&#x26A0; Caps Lock đang bật" Foreground="#E67E22" FontSize="12" HorizontalAlignment="Left" Margin="0,-6,0,8" Visibility="Collapsed"/>

        <Button x:Name="LoginButton" Style="{StaticResource RoleButtonStyle}" Click="Login_Click" Height="48" Padding="20,10" Margin="0" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="18" Foreground="#2A9D8F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LoginButtonText" Text="Đăng nhập" FontWeight="Bold" FontSize="18" Foreground="#111111"/>
                </StackPanel>
            </Grid>
        </Button>
        <TextBlock x:Name="StatusText" Text="" FontSize="14" Foreground="#C62828" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
</Window>

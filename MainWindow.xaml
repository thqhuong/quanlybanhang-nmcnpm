<Window x:Class="quanlybanhang_nmcnpm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:quanlybanhang_nmcnpm"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Bán hàng" Height="500" Width="550"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <Style TargetType="Button" x:Key="RoleButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="40,5,40,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FAFAFA"/>
                                <Setter Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center" Width="340">
        <Border Width="72" Height="72" CornerRadius="16" Background="#0C78E4" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Grid>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BF;" FontSize="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Width="18" Height="18" CornerRadius="9" Background="#2A9D8F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                    <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <TextBlock Text="QLBH" FontSize="18" FontWeight="Bold" Foreground="#0C78E4" HorizontalAlignment="Center"/>
        <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="Bold" Foreground="#123E82" HorizontalAlignment="Center" Margin="0,10,0,15"/>
        <TextBlock Text="Vui lòng đăng nhập để tiếp tục" FontSize="16" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <Grid Margin="0,0,0,12" Width="172" Height="36">
            <TextBox x:Name="UsernameBox" Height="36" VerticalContentAlignment="Center" Background="Transparent" Padding="10,0"/>
            <TextBlock Text="Tên đăng nhập" Foreground="#999" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Grid Margin="0,0,0,12" Width="172" Height="36">
            <PasswordBox x:Name="PasswordBox" Height="36" VerticalContentAlignment="Center" Background="Transparent" Padding="10,0" GotFocus="PasswordBox_GotFocus" LostFocus="PasswordBox_LostFocus"/>
            <TextBlock x:Name="PasswordPlaceholder" Text="Mật khẩu" Foreground="#999" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <Button Style="{StaticResource RoleButtonStyle}" Click="Login_Click" Height="48" Padding="10,10, 30, 10" Margin="0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" IsDefault="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="18" Foreground="#2A9D8F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Đăng nhập" FontWeight="Bold" FontSize="18" Foreground="#111111"/>
                </StackPanel>
            </Grid>
        </Button>
        <TextBlock x:Name="StatusText" Text="" FontSize="14" Foreground="#C62828" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="Nhấn Enter để đăng nhập">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="Phím tắt: Enter để đăng nhập" FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>

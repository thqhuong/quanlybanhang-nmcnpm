<Window x:Class="quanlybanhang_nmcnpm.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dashboard" Height="768" Width="1100"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SidebarMenuItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5F1FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE4F7"/>
                                <Setter Property="Foreground" Value="#0078D7"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0C78E4">
            <Grid Margin="10,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="28" Height="28" CornerRadius="7" Background="White" Margin="0,0,10,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BF;" Foreground="#0C78E4" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtTitle" Text="Hệ thống Quản lý Bán hàng v1.0" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F1F3F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,20,0,20" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="30" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="30" Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtRoleName" Text="..." FontWeight="Bold" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="#107C10" Margin="0,0,5,0"/>
                            <TextBlock Text="Đang hoạt động" Foreground="#107C10" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" IsChecked="True" Checked="Menu_Checked" Tag="TongQuan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" Checked="Menu_Checked" Tag="BanHang">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BF;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bán hàng (POS)" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" Checked="Menu_Checked" Tag="TaiKhoan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tài khoản" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" Checked="Menu_Checked" Tag="KhachHang">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khách hàng" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" Checked="Menu_Checked" Tag="HangHoa">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hàng hóa" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarMenuItem}" GroupName="Menu" Checked="Menu_Checked" Tag="PhieuNhap">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="16" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lập phiếu nhập kho" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Button Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="10,0,10,20" Padding="10" HorizontalContentAlignment="Left" Click="Logout_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF3B1;" FontSize="16" Foreground="#D62828" Margin="0,0,10,0"/>
                            <TextBlock Text="Đăng xuất" FontWeight="Bold" Foreground="#D62828" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FAF9F8">
                <ContentControl x:Name="MainContentControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0C78E4">
            <Grid Margin="10,0">
                <TextBlock Text="Sẵn sàng" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12"/>
                <TextBlock Text="Version 1.0.0" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
